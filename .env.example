# .env.example — todas las claves que leen las settings (backend/app/core/config.py).
# Copialo a .env y completá los valores. .env NUNCA se commitea (SEC-1, GEN-3).
# Este archivo no contiene ningún valor real.

# --- Obligatorias ---------------------------------------------------------------

# development | test | production. Sin default a propósito.
APP_ENV=development
# Cadena de conexión de SQLAlchemy, p. ej. postgresql+psycopg://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=

# --- Opcionales (el valor indicado es el default) -------------------------------

# Loguea todo el SQL. Prohibido en production (DAT-10).
# Los parámetros salen ocultos, pero el SQL se imprime por fuera del enmascarado
# de logs: cualquier literal en una sentencia sale en claro. Encendelo solo con
# datos de prueba.
DATABASE_ECHO=false
# Tope de espera del chequeo de base de GET /health, en segundos.
HEALTH_DB_TIMEOUT_SECONDS=2
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Timeouts del cliente HTTP saliente, en segundos.
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_POOL_TIMEOUT_SECONDS=5

# Rutas de los YAML de configuración. Vacío = config/<archivo>.yaml en la raíz del repo.
RESTAURANT_CONFIG_PATH=
MESSAGES_CONFIG_PATH=
HTTP_ERRORS_CONFIG_PATH=

# --- Base de desarrollo local (docker-compose.yml) ------------------------------
#
# Las lee `docker compose`, no la app: por eso van comentadas acá. Si usás la
# base del compose, descomentalas en tu .env y completá las dos claves. La app
# las ignora (solo lee las claves de arriba). Ver README, "Base de desarrollo
# local".
#
# Las dos claves son obligatorias y no tienen default: sin ellas `docker compose
# up` falla antes de crear nada. No pueden llevar caracteres que en una URL se
# codifican con `%` (`@`, `/`, `:`, `%`, `#`, `?`, espacios): alembic rompe con
# esa URL (D-15). Usá letras y números, p. ej. la salida de `openssl rand -hex 16`.
# El init corre solo con el volumen vacío: cambiar una clave después del primer
# arranque exige `docker compose down -v`, que BORRA los datos de desarrollo.
#
# Clave del superusuario de bootstrap `postgres`. Solo la usa el init.
# POSTGRES_PASSWORD=
# Rol de la app, sin privilegios. Default: bot_resto_user
# POSTGRES_APP_USER=bot_resto_user
# Clave del rol de la app. Es la misma que va dentro de DATABASE_URL.
# POSTGRES_APP_PASSWORD=
# Base de la app. Su gemela de tests destructivos es <valor>_test. Default: bot_resto
# POSTGRES_APP_DB=bot_resto
# Puerto de host, publicado solo en 127.0.0.1. Default: 5433
# POSTGRES_HOST_PORT=5433
#
# DATABASE_URL que corresponde con los defaults (CLAVE = POSTGRES_APP_PASSWORD):
# DATABASE_URL=postgresql+psycopg://bot_resto_user:CLAVE@127.0.0.1:5433/bot_resto
